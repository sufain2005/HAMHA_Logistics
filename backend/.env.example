# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection (SSL required for Neon)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/hamha_logistics?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-hamha-instance.us-east-2.aws.neon.tech/hamha_logistics?sslmode=require

# JWT Configuration
JWT_SECRET=hamha_super_secret_jwt_key_2026_crimson_shield
JWT_EXPIRES_IN=7d

# Mapbox Access Token (for backend routing calculations/geocoding if needed)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_or_secret_token

